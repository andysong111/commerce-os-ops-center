{
  "manifest_version": 3,
  "name": "Commerce OS · Shopling Stock State Sync",
  "short_name": "Stock State Sync",
  "version": "0.4.0",
  "description": "옵션상품은 Commerce OS 서버가 Shopling API로 정확 B코드 옵션상태를 검증·변경하고 현재수량을 보존한 뒤 A21 옵션송신만 웹 자동화합니다. 단품은 기존 A4→A21 경로를 유지합니다.",
  "permissions": ["storage", "tabs", "windows", "scripting", "webNavigation", "alarms"],
  "host_permissions": ["https://a.shopling.co.kr/*", "https://commerce-os-ops-center.vercel.app/*"],
  "background": { "service_worker": "background-v040.js" },
  "action": { "default_title": "Shopling 품절·판매중 동기화 v0.4.0", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://commerce-os-ops-center.vercel.app/*"], "js": ["content-ops-v021.js"], "run_at": "document_start" },
    { "matches": ["https://a.shopling.co.kr/*"], "js": ["main-shopling.js"], "world": "MAIN", "all_frames": true, "run_at": "document_start" },
    { "matches": ["https://a.shopling.co.kr/*"], "js": ["content-shopling-v030.js"], "all_frames": true, "run_at": "document_idle" }
  ]
}
