{
  "manifest_version": 3,
  "name": "Commerce OS 온돌패스 신청서 브리지",
  "short_name": "온돌패스 브리지",
  "version": "0.1.1",
  "description": "신청서 번호로 온돌패스 제품정보와 상품 이미지만 읽어 Commerce OS 바코드 생성기에 전달합니다.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://ondolpass.co.kr/*",
    "https://www.ondolpass.co.kr/*",
    "https://commerce-os-ops-center.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ondolpass.co.kr/*",
        "https://www.ondolpass.co.kr/*"
      ],
      "js": [
        "ondolpass-extractor.js",
        "content-ondolpass.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://commerce-os-ops-center.vercel.app/freight-barcode-request*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content-commerce-os.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
